
@baseUrl = http://localhost:3000

### 1. LOGIN ADMIN
# @name loginAdmin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "AdminParkir2026!"
}

### 2. LIHAT SEMUA USER
GET {{baseUrl}}/api/users
Authorization: Bearer {{loginAdmin.response.body.$.token}}


### 3. TAMBAH USER PETUGAS
POST {{baseUrl}}/api/users
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{
  "nama_lengkap": "Petugas Parkir 1",
  "username": "petugas1",
  "password": "PetugasParkir123",
  "role": "petugas",
  "status_aktif": 1
}

### 4. LIHAT USER BERDASARKAN ID
GET {{baseUrl}}/api/users/2
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### 5. UPDATE DATA USER
PUT {{baseUrl}}/api/users/2
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{
  "nama_lengkap": "Petugas Parkir Utama"
}

### 6. TAMBAH USER UNTUK TEST DELETE
POST {{baseUrl}}/api/users
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{
  "nama_lengkap": "User Percobaan Hapus",
  "username": "testhapus1",
  "password": "TestHapus123!",
  "role": "petugas",
  "status_aktif": 1
}
### 7. DELETE USER PERCOBAAN
DELETE {{baseUrl}}/api/users/3
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### 8. CEK USER SETELAH DELETE
GET {{baseUrl}}/api/users/3
Authorization: Bearer {{loginAdmin.response.body.$.token}}


